* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #fff;
  color: #202943;
}

.hero {
  min-height: 325px;
  background: #063d6b;
  color: #fff;
  text-align: center;
  padding: 38px 20px 55px;
}

.logo,
.footer-logo {
  width: 90px;
  height: 90px;
  margin: 0 auto 10px;
  border-radius: 22px;
  background: #ffd400;
  color: #063d6b;
  display: grid;
  place-items: center;
  font-size: 38px;
  font-weight: 900;
}

.brand {
  color: #ffd400;
  font-size: 38px;
  font-weight: 800;
}

.hero p {
  margin-top: 18px;
  font-size: 20px;
  color: #d9e4ef;
}

.card {
  width: min(640px, calc(100% - 32px));
  margin: 0 auto;
  padding: 58px 0 90px;
  text-align: center;
}

h1 {
  font-size: 30px;
  margin: 0 0 28px;
}

.notice {
  max-width: 560px;
  margin: 0 auto 25px;
  padding: 12px 15px;
  border-radius: 8px;
  background: #fff4cf;
  color: #6c5500;
  font-size: 14px;
  line-height: 1.5;
}

.phone-label {
  height: 86px;
  display: flex;
  align-items: center;
  border: 3px solid #ddd;
  border-radius: 15px;
  overflow: hidden;
  text-align: left;
}

.country-code {
  padding: 0 18px;
  font-size: 25px;
  color: #555;
  background: #fafafa;
  align-self: stretch;
  display: flex;
  align-items: center;
}

.phone-label input {
  min-width: 0;
  flex: 1;
  height: 100%;
  border: 0;
  outline: none;
  padding: 0 22px;
  font-size: 25px;
}

.pin-title {
  display: block;
  margin: 42px 0 25px;
  font-size: 20px;
  color: #777;
}

.pin-row {
  display: flex;
  gap: 16px;
  justify-content: center;
}

.pin {
  width: 76px;
  height: 76px;
  border: 3px solid #ddd;
  border-radius: 12px;
  text-align: center;
  font-size: 30px;
  outline: none;
}

.pin:focus {
  border-color: #063d6b;
}

button {
  width: 100%;
  height: 70px;
  margin-top: 28px;
  border: 0;
  border-radius: 14px;
  background: #e5e5e5;
  color: #aaa;
  font-size: 22px;
  font-weight: 800;
}

button.enabled {
  background: #ffd400;
  color: #063d6b;
  cursor: pointer;
}

.message {
  min-height: 24px;
  margin-top: 18px;
  font-size: 15px;
}

footer {
  min-height: 260px;
  background: #063d6b;
  color: #fff;
  text-align: center;
  padding: 70px 20px 35px;
  border-radius: 50% 50% 0 0 / 15% 15% 0 0;
}

.footer-logo {
  width: 62px;
  height: 62px;
  font-size: 27px;
}

footer strong {
  display: block;
  color: #ffd400;
  font-size: 28px;
  margin-bottom: 10px;
}

footer p {
  color: #d9e4ef;
  font-size: 14px;
}

@media (max-width: 520px) {
  .hero {
    min-height: 300px;
  }

  h1 {
    font-size: 26px;
  }

  .pin-row {
    gap: 8px;
  }

  .pin {
    width: 58px;
    height: 68px;
  }

  .phone-label input,
  .country-code {
    font-size: 20px;
  }
}